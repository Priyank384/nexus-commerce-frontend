# Copy this file to .env.local and adjust.
# NexusCommerce backend base URL (no trailing slash). Server-side only.
API_BASE_URL=http://localhost:3001

# Frontend dev port. Matches create-next-app default.
PORT=3000

# Extra hostnames next/image may load from, comma-separated and without a scheme.
# Production sets this to the R2 public hostname (e.g. pub-xxxx.r2.dev).
# NEXT_IMAGE_HOSTS=pub-xxxx.r2.dev
