# Copy this file to .env.local and adjust.
# NexusCommerce backend base URL (no trailing slash). Server-side only.
API_BASE_URL=http://localhost:3001

# Frontend dev port. Matches create-next-app default.
PORT=3000

# Extra hostnames next/image may load from, comma-separated and without a scheme.
# Production sets this to the Supabase Storage public hostname.
# NEXT_IMAGE_HOSTS=xxxxxxxx.supabase.co

# Canonical origin for <link rel="canonical">, Open Graph URLs and the sitemap.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL (injected by Vercel), then http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://nexuscommerce.example
